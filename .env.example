# Copy to .env to run the package tests. Shell variables win over this file.

# PostgreSQL with pgvector. Leave DB_HOST empty to start a database with Docker instead.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=memory_test
DB_USERNAME=postgres
DB_PASSWORD=

# Evals (./vendor/bin/pest --evals) call real models through these settings.
# They use any provider of config/ai.php, and this model for the test agent and the memory agents.
AI_MEMORY_PROVIDER=
AI_MEMORY_MODEL=
AI_MEMORY_TIMEOUT=120

# Embeddings. Use a multilingual model for the French, Chinese and Japanese cases.
# Set the dimensions when the provider reports no size, such as Ollama.
AI_MEMORY_EMBEDDINGS_PROVIDER=
AI_MEMORY_EMBEDDINGS_MODEL=
AI_MEMORY_DIMENSIONS=

# Optional: test the classification decider or the permission guards.
AI_MEMORY_DECIDER=agent
AI_MEMORY_PERMISSION_GUARD=none
AI_MEMORY_CLASSIFICATION_PROVIDER=
AI_MEMORY_CLASSIFICATION_MODEL=

# Use simple when the cases mix languages.
AI_MEMORY_FULLTEXT_LANGUAGE=simple

# Provider credentials, as config/ai.php reads them. Fill only the ones you use.
OLLAMA_URL=http://localhost:11434
OLLAMA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# The evals judge stored memories with TypeSafe classification by default.
TYPESAFE_API_KEY=
