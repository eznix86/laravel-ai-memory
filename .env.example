# Copy to .env to run the tests locally. Shell variables win over this file.

# Database: an existing PostgreSQL with pgvector. Leave MEMORY_TEST_DB_HOST empty to start one with Docker instead.
MEMORY_TEST_DB_HOST=127.0.0.1
MEMORY_TEST_DB_PORT=5432
MEMORY_TEST_DB_DATABASE=memory_test
MEMORY_TEST_DB_USERNAME=postgres
MEMORY_TEST_DB_PASSWORD=

# Live tests in tests/Integration call real models. 0 skips them.
MEMORY_LIVE=0

# Provider and model the test agent chats with: any provider of config/ai.php and any of its models.
MEMORY_LIVE_PROVIDER=
MEMORY_LIVE_CHAT_MODEL=

# Embeddings. MEMORY_DIMENSIONS must match the embedding model. Use a multilingual model for the French and Chinese cases.
MEMORY_LIVE_EMBEDDINGS_PROVIDER=
MEMORY_LIVE_EMBEDDINGS_MODEL=
MEMORY_DIMENSIONS=1536

# Provider and model of the decider, extractor, consolidator and agent permission guard. Empty uses the default of config/ai.php.
MEMORY_PROVIDER=
MEMORY_MODEL=
MEMORY_TIMEOUT=120

# PostgreSQL text search configuration of the keyword search, e.g. english, french, simple.
MEMORY_FULLTEXT_LANGUAGE=english

# Duplicate decider: agent or classification.
MEMORY_DECIDER=agent

# Permission guard: none, agent or classification.
MEMORY_PERMISSION_GUARD=none

# Classification provider and model of the classification decider and guard, e.g. typesafe, openai or openrouter. Empty uses the default of config/ai.php.
MEMORY_CLASSIFICATION_PROVIDER=
MEMORY_CLASSIFICATION_MODEL=

# Provider credentials. Fill only the ones you use.
OLLAMA_URL=http://localhost:11434
OLLAMA_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
