# Copy to .env to run the tests locally. Shell variables win over this file.

# Database: an existing PostgreSQL with pgvector. Leave MEMORY_TEST_DB_HOST empty to start one with Docker instead.
MEMORY_TEST_DB_HOST=127.0.0.1
MEMORY_TEST_DB_PORT=5432
MEMORY_TEST_DB_DATABASE=memory_test
MEMORY_TEST_DB_USERNAME=postgres
MEMORY_TEST_DB_PASSWORD=

# Live tests in tests/Integration call real models. 0 skips them.
MEMORY_LIVE=0

# Provider and model the test agent chats with.
MEMORY_LIVE_PROVIDER=ollama
MEMORY_LIVE_CHAT_MODEL=granite4:3b

# Embeddings. MEMORY_DIMENSIONS must match the embedding model.
MEMORY_LIVE_EMBEDDINGS_PROVIDER=ollama
MEMORY_LIVE_EMBEDDINGS_MODEL=nomic-embed-text
MEMORY_DIMENSIONS=768

# Provider and model of the decider, extractor and consolidator agents.
MEMORY_PROVIDER=ollama
MEMORY_MODEL=granite4:3b
MEMORY_TIMEOUT=120

# Duplicate decider: agent or classification.
MEMORY_DECIDER=agent

# Permission guard: none or classification.
MEMORY_PERMISSION_GUARD=none

# Classification provider and model, used by the classification decider and the permission guard.
MEMORY_CLASSIFICATION_PROVIDER=typesafe
MEMORY_CLASSIFICATION_MODEL=jev-latest

# Provider credentials. Fill only the ones you use.
OLLAMA_URL=http://localhost:11434
OLLAMA_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
